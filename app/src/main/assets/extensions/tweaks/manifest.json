{
  "manifest_version": 2,
  "name": "YouTube app helper",
  "version": "2.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "tweaks@youtube.gecko.local"
    }
  },
  "permissions": [
    "nativeMessaging",
    "geckoViewAddons",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://m.youtube.com/*",
        "*://www.youtube.com/*",
        "*://youtube.com/*"
      ],
      "css": [
        "tweaks.css"
      ],
      "js": [
        "background-play.js",
        "settings-button.js",
        "ads-player.js",
        "prefs.js",
        "swipe-pip.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://m.youtube.com/*",
        "*://www.youtube.com/*",
        "*://youtube.com/*",
        "*://music.youtube.com/*"
      ],
      "js": [
        "ads-page.js",
        "quality.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "webauthn-page.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "webauthn-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
